generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["balnotes"]
}

enum GradeLevel {
  PREP
  NINE
  TEN
  ELEVEN
  TWELVE

  @@schema("balnotes")
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED

  @@schema("balnotes")
}

enum UserStatus {
  ACTIVE
  BANNED

  @@schema("balnotes")
}

model User {
  id             String     @id
  email          String     @unique
  name           String
  picture        String?
  status         UserStatus @default(ACTIVE)
  banReason      String?
  bannedAt       DateTime?
  bannedById     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  notes          Note[]
  votes          NoteVote[]
  teacherQuotes  TeacherQuote[]

  @@index([status])
  @@map("balnotes_profile_info")
  @@schema("balnotes")
}

model OAuthAttempt {
  stateHash    String   @id
  codeVerifier String
  nextPath     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_attempts")
  @@schema("balnotes")
}

model Subject {
  id         String     @id @default(cuid())
  gradeLevel GradeLevel
  name       String
  slug       String
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  notes Note[]
  teacherQuotes TeacherQuote[]

  @@unique([gradeLevel, slug])
  @@index([gradeLevel, isActive, sortOrder])
  @@map("subjects")
  @@schema("balnotes")
}

model Note {
  id              String           @id @default(cuid())
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  description     String?          @db.Text
  gradeLevel      GradeLevel
  subjectId       String?
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  customSubject   String?
  status          SubmissionStatus @default(DRAFT)
  rejectionReason String?          @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  submittedAt     DateTime?
  publishedAt     DateTime?
  isRecommended   Boolean          @default(false)
  recommendedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assets NoteAsset[]
  votes  NoteVote[]

  @@index([status, publishedAt])
  @@index([status, isRecommended, recommendedAt])
  @@index([gradeLevel, status, publishedAt])
  @@index([subjectId, status, publishedAt])
  @@index([authorId, status, updatedAt])
  @@map("notes")
  @@schema("balnotes")
}

model NoteAsset {
  id           String   @id @default(cuid())
  noteId       String
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  blobUrl      String
  pathname     String   @unique
  originalName String
  contentType  String
  size         Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([noteId, sortOrder])
  @@map("note_assets")
  @@schema("balnotes")
}

model NoteVote {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([userId])
  @@map("note_votes")
  @@schema("balnotes")
}

model TeacherQuote {
  id              String           @id @default(cuid())
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  teacherName     String
  quote           String
  context         String?
  gradeLevel      GradeLevel?
  subjectId       String?
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  status          SubmissionStatus @default(PENDING)
  rejectionReason String?          @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([subjectId, status, publishedAt])
  @@index([authorId, status, updatedAt])
  @@map("teacher_quotes")
  @@schema("balnotes")
}
