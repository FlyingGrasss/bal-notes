# Supabase PostgreSQL transaction pooler (port 6543) for application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase direct connection (port 5432) used only by Prisma CLI/migrations.
# The schema query parameter isolates BAL Notes migrations in the shared database.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=balnotes"

APP_URL="http://localhost:3000"
HOMEWORK_APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# The same Supabase Auth project used by BAL ID. These establish the local
# Supabase session after BAL ID OAuth and allow refresh/revocation to work.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# BAL ID's Supabase OAuth issuer, normally https://PROJECT_REF.supabase.co/auth/v1
BAL_ID_ISSUER_URL=""
BAL_ID_CLIENT_ID=""
BAL_ID_CLIENT_SECRET=""

# Comma-separated BAL ID email addresses with BAL Notes admin access.
ADMIN_EMAILS=""

# Token for a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=""
